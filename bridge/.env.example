# ---------------------------------------------------------------------------
# VTT-Light Discord bridge
# Copy this file to .env and fill in the values. Never commit .env.
# ---------------------------------------------------------------------------

# Bot token from https://discord.com/developers/applications -> your app -> Bot
DISCORD_TOKEN=

# Channel IDs to relay into POPS (comma separated). Leave empty to relay every
# guild text channel the bot can read (not recommended on busy servers).
DISCORD_CHANNELS=

# Channel IDs where the bot answers every message with the POPS AI
# (comma separated). Mentioning the bot works in any relayed channel.
DISCORD_AI_CHANNELS=

# Optional: also send POPS messages (questions, answers, dice rolls) to Discord.
MIRROR_POPS=false

# Channel ID used for the POPS -> Discord mirror. Defaults to the first
# channel in DISCORD_CHANNELS.
MIRROR_CHANNEL=

# Realtime Database base URL (no trailing slash).
FIREBASE_DB_URL=https://vtt-light-default-rtdb.europe-west1.firebasedatabase.app

# Existing POPS AI endpoints (no need to change unless they move).
RAG_API_URL=https://traveller-rag-api-600932660900.us-central1.run.app/search
SLM_API_URL=https://traveller-slm-service-600932660900.us-central1.run.app/api/generate
